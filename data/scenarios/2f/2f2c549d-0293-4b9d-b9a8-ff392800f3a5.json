        { "noLog": "Grizzly Bears is destroyed" },
        { "handCount": [0, 1] },
        { "unsimulated": 0 }
      ]
    },
    {
      "name": "Kozilek's Command's fourth mode exiles up to X cards from graveyards",
      "cr": "701.19a",
      "ruling": "The fourth mode exiles up to X target cards from any graveyards; with X=2 both targeted cards leave the opponent's graveyard for exile.",
