{
  "oracleId": "2f2c549d-0293-4b9d-b9a8-ff392800f3a5",
  "name": "Kozilek's Command",
  "scenarios": [
    {
      "name": "The first mode makes the targeted player create X Eldrazi Spawn tokens",
      "cr": "111.1",
      "ruling": "The tokens are created by the player that mode targets, so with X=2 the opponent gets two 0/1 colorless Eldrazi Spawn even though you cast the spell.",
      "seats": [
        { "bf": ["Wastes", "Wastes", "Wastes", "Wastes"], "hand": ["Kozilek's Command"] },
        {}
      ],
      "script": [
        { "cast": "Kozilek's Command", "x": 2, "modes": [0, 1], "targets": [["P1"], ["P0"]] },
        { "resolve": true }
      ],
      "expect": [
        { "events": { "type": "create-token", "min": 1 } },
        { "zoneCount": [1, "battlefield", 2] },
        { "zoneCount": [0, "battlefield", 4] },
        { "pt": ["Eldrazi Spawn", 0, 1] },
        { "control": ["Eldrazi Spawn", 1] },
        { "zone": ["Kozilek's Command", "graveyard"] },
        { "unsimulated": 0 }
      ]
    },
    {
      "name": "The second mode makes the targeted player scry X and then draw a card",
      "cr": "701.17a",
      "ruling": "The scry and the draw both belong to the player that mode targets, so the opponent's hand grows by one and their library shrinks by one while yours does not.",
      "seats": [
        { "bf": ["Wastes", "Wastes", "Wastes", "Wastes"], "hand": ["Kozilek's Command"] },
        {}
      ],
      "script": [
        { "cast": "Kozilek's Command", "x": 2, "modes": [0, 1], "targets": [["P0"], ["P1"]] },
        { "resolve": true }
      ],
      "expect": [
        { "handCount": [1, 1] },
        { "libraryCount": [1, 19] },
        { "handCount": [0, 0] },
        { "libraryCount": [0, 20] },
        { "zoneCount": [0, "battlefield", 6] },
        { "unsimulated": 0 }
      ]
    },
    {
      "name": "The third mode exiles a creature with mana value X or less",
      "cr": "202.3b",
      "ruling": "Grizzly Bears has mana value 2, so with X=2 it is a legal target; it is exiled rather than destroyed, so nothing reaches the graveyard.",
      "seats": [
        { "bf": ["Wastes", "Wastes", "Wastes", "Wastes"], "hand": ["Kozilek's Command"] },
        { "bf": ["Grizzly Bears"] }
      ],
      "script": [
        { "cast": "Kozilek's Command", "x": 2, "modes": [1, 2], "targets": [["P0"], ["Grizzly Bears"]] },
        { "resolve": true }
      ],
      "expect": [
        { "zone": ["Grizzly Bears", "exile"] },
        { "zoneCount": [1, "battlefield", 0] },
        { "graveyardCount": [1, 0] },
        { "noLog": "Grizzly Bears is destroyed" },
        { "handCount": [0, 1] },
        { "unsimulated": 0 }
      ]
    },
    {
      "name": "The fourth mode exiles up to X target cards from graveyards",
      "cr": "406.2",
      "ruling": "The fourth mode reaches any graveyard, so with X=2 both targeted cards leave the opponent's graveyard for exile.",
      "seats": [
        { "bf": ["Wastes", "Wastes", "Wastes", "Wastes"], "hand": ["Kozilek's Command"] },
        { "graveyard": ["Hill Giant", "Lightning Bolt"] }
      ],
      "script": [
        { "cast": "Kozilek's Command", "x": 2, "modes": [1, 3], "targets": [["P0"], ["Hill Giant", "Lightning Bolt"]] },
        { "resolve": true }
      ],
      "expect": [
        { "zone": ["Hill Giant", "exile"] },
        { "zone": ["Lightning Bolt", "exile"] },
        { "graveyardCount": [1, 0] },
        { "handCount": [0, 1] },
        { "unsimulated": 0 }
      ]
    },
    {
      "name": "An Eldrazi Spawn token sacrifices itself for one colorless mana",
      "cr": "605.1a",
      "ruling": "The token has the mana ability \"Sacrifice this token: Add {C}\", which does not use the stack; the token leaves the battlefield and {C} stays in the pool.",
      "seats": [
        { "bf": ["Wastes", "Wastes", "Wastes"], "hand": ["Kozilek's Command"] },
        {}
      ],
      "script": [
        { "cast": "Kozilek's Command", "x": 1, "modes": [0, 1], "targets": [["P0"], ["P0"]] },
        { "resolve": true },
        { "activate": "Eldrazi Spawn" }
      ],
      "expect": [
        { "mana": [0, "C"] },
        { "zoneCount": [0, "battlefield", 3] },
        { "handCount": [0, 1] },
        { "unsimulated": 0 }
      ]
    }
  ]
}
