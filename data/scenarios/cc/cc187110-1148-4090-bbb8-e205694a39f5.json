{
  "oracleId": "cc187110-1148-4090-bbb8-e205694a39f5",
  "name": "Counterspell",
  "scenarios": [
    {
      "name": "Counterspell counters the spell it targets",
      "cr": "701.5a",
      "ruling": "A countered spell is put into its owner's graveyard without resolving, so its effect never happens.",
      "seats": [
        { "bf": ["Mountain"], "hand": ["Lightning Bolt"] },
        { "bf": ["Island", "Island"], "hand": ["Counterspell"] }
      ],
      "script": [
        { "cast": "Lightning Bolt", "targets": [["P1"]] },
        { "cast": "Counterspell", "targets": [["Lightning Bolt"]], "by": 1 },
        { "resolve": true }
      ],
      "expect": [
        { "life": [1, 20] },
        { "zone": ["Lightning Bolt", "graveyard"] },
        { "zone": ["Counterspell", "graveyard"] },
        { "events": { "type": "countered", "min": 1, "max": 1 } },
        { "stack": 0 },
        { "unsimulated": 0 }
      ]
    },
    {
      "name": "Counterspell waits on top of the spell it answers",
      "cr": "405.2",
      "ruling": "The stack resolves one object at a time, last in first out.",
      "seats": [
        { "bf": ["Mountain"], "hand": ["Lightning Bolt"] },
        { "bf": ["Island", "Island"], "hand": ["Counterspell"] }
      ],
      "script": [
        { "cast": "Lightning Bolt", "targets": [["P1"]] },
        { "cast": "Counterspell", "targets": [["Lightning Bolt"]], "by": 1 }
      ],
      "expect": [
        { "stackNames": ["Counterspell", "Lightning Bolt"] },
        { "stack": 2 },
        { "life": [1, 20] },
        { "handCount": [1, 0] }
      ]
    },
    {
      "name": "A countered creature spell never reaches the battlefield",
      "cr": "701.5a",
      "seats": [
        { "bf": ["Forest", "Forest"], "hand": ["Grizzly Bears"] },
        { "bf": ["Island", "Island"], "hand": ["Counterspell"] }
      ],
      "script": [
        { "cast": "Grizzly Bears" },
        { "cast": "Counterspell", "targets": [["Grizzly Bears"]], "by": 1 },
        { "resolve": true }
      ],
      "expect": [
        { "zone": ["Grizzly Bears", "graveyard"] },
        { "zoneCount": [0, "battlefield", 2] },
        { "graveyardCount": [0, 1] },
        { "events": { "type": "countered", "min": 1, "max": 1 } },
        { "unsimulated": 0 }
      ]
    }
  ]
}
