      ],
      "script": [
        { "passUntil": "end" },
        { "resolve": true }
      ],
      "expect": [
        { "handCount": [0, 1] },
        { "tapped": ["Colossal Dreadmaw", false] },
        { "tapped": ["Grizzly Bears", false] },
        { "life": [1, 20] },
        { "unsimulated": 0 }
      ]
    },
    {
